{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/app-version.ts",
    "src/version.json"
  ],
  "compilerOptions": {
    "composite": true,
    "resolveJsonModule": true,
    "types": ["electron-vite/node"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@baishou/core": ["../../packages/core/src/index.ts"],
      "@baishou/core/*": ["../../packages/core/src/*"],
      "@baishou/core/shared": ["../../packages/core/src/index.shared.ts"]
    }
  }
}
